{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src/app/syllogimous/experimental",
    "outDir": "./dist/audit-core",
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [],
    "sourceMap": false,
    "declaration": false,
    "importHelpers": false,
    "noEmitOnError": true
  },
  "include": [
    "src/app/syllogimous/experimental/reasoning-core/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
